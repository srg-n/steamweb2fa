/*
 * Cloudflare Pages / Netlify response headers.
 *
 * GitHub Pages cannot send custom headers, which is why the build also embeds
 * a CSP <meta> tag. frame-ancestors is only honoured as a header, so hosting
 * there requires copying this file into your own server config.
 */
/*
  /index.html
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin

  /sw.js
  Cache-Control: no-cache

  /manifest.json
  Cache-Control: public, max-age=3600

  /icons/*
  Cache-Control: public, max-age=604800